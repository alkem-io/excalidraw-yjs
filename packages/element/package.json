{
  "name": "@excalidraw-yjs/element",
  "version": "0.5.1",
  "upstream": {
    "repository": "https://github.com/excalidraw/excalidraw",
    "commit": "864353be5ff8b15489a63628c2708e453c83c642"
  },
  "type": "module",
  "types": "./dist/types/element/src/index.d.ts",
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/element/src/index.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    },
    "./headless": {
      "types": "./dist/types/element/src/headless.d.ts",
      "require": "./dist/cjs/headless.cjs",
      "development": "./dist/dev/headless.js",
      "production": "./dist/prod/headless.js",
      "default": "./dist/prod/headless.js"
    },
    "./*": {
      "types": "./dist/types/element/src/*.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    },
    "./visualdebug": {
      "types": "./dist/types/element/src/visualdebug.d.ts",
      "development": "./dist/dev/visualdebug.js",
      "production": "./dist/prod/visualdebug.js",
      "default": "./dist/prod/visualdebug.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "description": "Excalidraw elements-related logic",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "excalidraw",
    "excalidraw-utils"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all",
      "not safari < 12",
      "not kaios <= 2.5",
      "not edge < 79",
      "not chrome < 70",
      "not and_uc < 13",
      "not samsung < 10"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "bugs": "https://github.com/alkem-io/excalidraw-yjs/issues",
  "repository": "https://github.com/alkem-io/excalidraw-yjs",
  "scripts": {
    "gen:types": "rimraf types && tsc",
    "build:esm": "rimraf dist && node ../../scripts/buildBase.js && pnpm run gen:types"
  },
  "dependencies": {
    "@excalidraw-yjs/common": "workspace:*",
    "@excalidraw-yjs/math": "workspace:*",
    "@excalidraw-yjs/fractional-indexing": "workspace:*"
  },
  "peerDependencies": {
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "yjs": "^13.6.27"
  }
}
